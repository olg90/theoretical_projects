f = 100
T = 1 / f

naps = 50

# Manually specified minimum and maximum values for kinetic rates
rate_limits = {
    'kDL': {'min': 0.1, 'max': 100},
    'kLD': {'min': 0.1, 'max': 100},
    'kLU': {'min': 0.1, 'max': 100},
    'kUL': {'min': 0.1, 'max': 100}
}

rate_names = ['kDL','kLD','kLU','kUL']

base_rates = {
    'kDL': kDL,
    'kLD': kLD,
    'kLU': kLU,
    'kUL': kUL
}

colors = {
    'kDL': 'tab:blue',
    'kLD': 'tab:orange',
    'kLU': 'tab:green',
    'kUL': 'tab:red'
}

# ============================================================
# Initial steady state
# ============================================================

denom = kDL*kLU + kDL*kUL + kLD*kUL

puss = (kDL*kLU) / denom
pLss = (kDL*kUL) / denom
pdss = (kLD*kUL) / denom

initial_states = [puss,pLss,pdss]

# ============================================================
# Function to calculate rho(n_D,n_L)
# ============================================================

def calculate_rho(pr_values,k_values_dict):

    # State probabilities
    pu = np.zeros(naps)
    pL = np.zeros(naps)
    pd = np.zeros(naps)

    pu[0],pL[0],pd[0] = initial_states

    for i in range(naps - 1):

        kDL_i = k_values_dict['kDL'][i]
        kLD_i = k_values_dict['kLD'][i]
        kLU_i = k_values_dict['kLU'][i]
        kUL_i = k_values_dict['kUL'][i]

        Q = np.array([
            [-kUL_i,          kUL_i,          0],
            [ kLU_i, -(kLU_i + kLD_i),       kLD_i],
            [   0,           kDL_i,       -kDL_i]
        ])

        P = expm(Q*T)

        puu = P[0,0]
        puL = P[0,1]
        pud = P[0,2]

        pLu = P[1,0]
        pLL = P[1,1]
        pLd = P[1,2]

        pd[i+1] = (
            pd[i] * (1 - pr_values[i]) * (1 - P[2,0] - P[2,1])
            + pd[i] * pr_values[i] * pud
            + pu[i] * pud
            + pL[i] * pLd
        )

        pL[i+1] = (
            pL[i] * (1 - pLu - pLd)
            + pd[i] * (1 - pr_values[i]) * P[2,1]
            + pd[i] * pr_values[i] * puL
            + pu[i] * puL
        )

        pu[i+1] = 1 - pL[i+1] - pd[i+1]

    # Multinomial covariance and variances
    cov_dL = -M * pd * pL

    var_d = M * pd * (1 - pd)
    var_L = M * pL * (1 - pL)

    rho = np.zeros(naps)

    valid = (var_d > 0) & (var_L > 0)

    rho[valid] = (
