#%%  E[b_i b_(i+j)] matrix exponential

import numpy as np
import matplotlib.pyplot as plt
from scipy.linalg import expm

kDL = 10
kLD = 100
kLU = 10
kUL = 20

M = 100
f = 10
T = 1 / f

pr0 = 0.1
prinf = 0.1
thr = 20
H = 2

i = 1
j_max = 100

# Maximum AP index that will be needed
max_ap = i + j_max

def get_transition_matrix(T):
    Q = np.array([
        [-kUL,          kUL,          0],
        [ kLU, -(kLU + kLD),         kLD],
        [   0,           kDL,       -kDL]
    ])
    return expm(Q*T)

# Transition probabilities over one inter-AP interval
P = get_transition_matrix(T)
# this is the infinitesimal matrix which gives the transition rates for the markov chain between states


puu = P[0,0]
puL = P[0,1]
pud = P[0,2]

pLu = P[1,0]
pLL = P[1,1]
pLd = P[1,2]

pdu = P[2,0]
pdL = P[2,1]
pdd = P[2,2]

# Release probability
pr = pr0 + (prinf - pr0) / (1 + (np.arange(max_ap + 1) / thr)**H)

# Marginal state probabilities before each AP
pL = np.zeros(max_ap + 1)
pd = np.zeros(max_ap + 1)
pu = np.zeros(max_ap + 1)

pu[0] = 1

for n in range(max_ap):

    pd[n + 1] = (
        pd[n] * (1 - pr[n]) * pdd
        + pd[n] * pr[n] * pud
        + pu[n] * pud
        + pL[n] * pLd
    )

    pL[n + 1] = (
        pL[n] * (1 - pLu - pLd)
        + pd[n] * (1 - pr[n]) * pdL
        + pd[n] * pr[n] * puL
        + pu[n] * puL
    )

    pu[n + 1] = 1 - pL[n + 1] - pd[n + 1]

# Probability that one particular site releases at AP i
p_ri = pd[i] * pr[i]

j_values = np.arange(1, j_max + 1)
E_bibi_j = np.zeros(len(j_values))

for n, j in enumerate(j_values):

    # After release at AP i, the site is in U.
    # Therefore, at AP i+1:
    #
    # P(D_(i+1), b_i = 1) = p_ri * pdu
    # P(L_(i+1), b_i = 1) = p_ri * puL
    # P(U_(i+1), b_i = 1) = p_ri * puu

    pD = p_ri * pud
    pL_i = p_ri * puL
    pU = p_ri * puu

    # Propagate from AP i+1 to AP i+j
    for k in range(i + 1, i + j):

        pD_new = (
            pD * (1 - pr[k]) * pdd
            + pD * pr[k] * pud
            + pL_i * pLd
            + pU * pud
        )

        pL_new = (
            pD * (1 - pr[k]) * pdL
            + pD * pr[k] * puL
            + pL_i * pLL
            + pU * puL
        )

        pU_new = (
            pD * (1 - pr[k]) * pdu
            + pD * pr[k] * puu
            + pL_i * pLu
            + pU * puu
        )

        pD = pD_new
        pL_i = pL_new
        pU = pU_new

    # Same-site contribution
    p_ri_rij = pD * pr[i + j]

    # Probability that a different site releases at AP i+j
    p_rij = pd[i + j] * pr[i + j]

    E_bibi_j[n] = (
        M * p_ri_rij
        + M * (M - 1) * p_ri * p_rij
    )

plt.figure(figsize=(7, 5))
plt.plot(j_values, E_bibi_j, 'o-')
plt.xlabel(r'$j$')
plt.ylabel(r'$E[b_i b_{i+j}]$')
plt.tight_layout()
plt.show()

for j, value in zip(j_values, E_bibi_j):
    print(f'j = {j:3d}, E[b_i b_(i+j)] = {value:.8f}')    

