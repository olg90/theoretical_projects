import numpy as np
import matplotlib.pyplot as plt
from scipy.linalg import expm
from scipy.optimize import differential_evolution

# Model parameters
pool_counts = [1,2,3,4]

M = 100

f = 10
T = 1 / f
naps = 100

i_values = np.arange(naps)

# Each row: [pr0, prinf, thr, H]
pr_params = np.array([
    [0.1, 1.0, 20, 2],
    [0.1, 0.2, 20, 2],
    [0.1, 0.5, 20, 2],
    [0.1, 0.3, 20, 2]
])

# Each row: [kUL, kLU, kLD, kDL]
rate_params = np.array([
    [20, 10, 100, 10],
    [10, 1, 50, 1],
    [10, 1, 50, 1],
    [10, 1, 50, 1]
])


def get_transition_probs(T,kUL,kLU,kLD,kDL):

    A = np.array([
        [-kUL,               kLU,               0],
        [ kUL, -(kLU + kLD),             kDL],
        [   0,               kLD,           -kDL]
    ])

    P = expm(A.T*T)

    pUU = P[0,0]
    pUL = P[0,1]
    pUD = P[0,2]

    pLU = P[1,0]
    pLL = P[1,1]
    pLD = P[1,2]

    pDU = P[2,0]
    pDL = P[2,1]
    pDD = P[2,2]

    return pUU,pUL,pUD,pLU,pLL,pLD,pDU,pDL,pDD


def get_mean_qc(pr_params,rate_params):

    pr0,prinf,thr,H = pr_params
    kUL,kLU,kLD,kDL = rate_params

    pr = pr0 + (prinf-pr0)/(1+(i_values/thr)**H)

    pUU,pUL,pUD,pLU,pLL,pLD,pDU,pDL,pDD = get_transition_probs(
        T,kUL,kLU,kLD,kDL
    )

    pu = np.zeros(naps)
    pL = np.zeros(naps)
    pd = np.zeros(naps)

    pu[0] = 1

    for i in range(naps-1):

        pd[i+1] = (
            pd[i]*(1-pr[i+1])*(1-pDU-pDL)
            +pd[i]*pr[i+1]*pUD
            +pu[i]*pUD
            +pL[i]*pLD
        )

        pL[i+1] = (
            pL[i]*(1-pLU-pLD)
            +pd[i]*(1-pr[i+1])*pDL
            +pd[i]*pr[i+1]*pUL
            +pu[i]*pUL
        )

        pu[i+1] = 1-pL[i+1]-pd[i+1]

    q = pr[1:]*pd[:-1]

    mean_qc = np.zeros(naps)
    mean_qc[1:] = M*q

    return mean_qc


# ------------------------------------------------------------
# FIRST POOL IS FIXED
# Uses ONLY the first array in each parameter array
# ------------------------------------------------------------

mean_qc_1 = get_mean_qc(
    pr_params[0],
    rate_params[0]
)

mean_qc_all = {
    1: mean_qc_1
}

optimized_params = np.zeros((4,8))

optimized_params[0,:4] = pr_params[0]
optimized_params[0,4:] = rate_params[0]


# ------------------------------------------------------------
# Optimize pools 2, 3, and 4 independently
# to match the fixed first-pool mean QC
# ------------------------------------------------------------

bounds = [
    (0.001,1.0),     # pr0
    (0.001,1.0),     # prinf
    (1.0,100.0),     # thr
    (0.5,5.0),       # H
    (0.1,100.0),     # kUL
    (0.1,100.0),     # kLU
    (0.1,100.0),     # kLD
    (0.1,100.0)      # kDL
]


for pool in [2,3,4]:

    def objective(x):

        mean_qc = get_mean_qc(
            x[:4],
            x[4:]
        )

        valid = mean_qc_1 > 1e-8

        relative_error = (
            (mean_qc[valid]-mean_qc_1[valid])
            /mean_qc_1[valid]
        )

        return np.mean(relative_error**2)


    result = differential_evolution(
        objective,
        bounds,
        maxiter=1000,
        popsize=20,
        tol=1e-9,
        polish=True,
        seed=pool
    )

    optimized_params[pool-1] = result.x

    mean_qc_all[pool] = get_mean_qc(
        result.x[:4],
        result.x[4:]
    )


# ------------------------------------------------------------
# Print parameters
# ------------------------------------------------------------

for pool in pool_counts:

    print()
    print(f'Pool {pool}')

    print(f'pr0   = {optimized_params[pool-1,0]:.8f}')
