#%% one pool model - Lag-1 autocorrelation

import numpy as np
import matplotlib.pyplot as plt

# Model parameters
kDL = 10
kLD = 100
kLU = 10
kUL = 20

M = 100

f = 10
T = 1 / f
naps = 100

# Release probability parameters
pr0 = 0.1
prinf = 0.1
thr = 20
H = 2

# Release probability
pr = np.zeros(naps)

for i in range(naps):
    pr[i] = pr0 + (prinf - pr0) / (1 + (i / thr)**H)


# Transition probabilities

def get_pDU(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(-0.5 * (S - D) * T)

    return (
        kDL * (E1 - E2)
        / D
        + E1 * E2 * 0
    )


def get_pDL(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(-0.5 * (S - D) * T)

    return kDL * (E2 - E1) / D


def get_pDD(T):
    return 1 - get_pDU(T) - get_pDL(T)


def get_pLU(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(-0.5 * (S - D) * T)

    return kLU * (E2 - E1) / D


def get_pLD(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(-0.5 * (S - D) * T)

    return kLD * (E2 - E1) / D


def get_pLL(T):
    return 1 - get_pLU(T) - get_pLD(T)


def get_pUU(T):
    return 1 - get_pUL(T) - get_pUD(T)


def get_pUL(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(-0.5 * (S - D) * T)

    return kUL * (E2 - E1) / D


def get_pUD(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(-0.5 * (S - D) * T)

    return (
        kUL * kDL * (E1 - E2)
        / (D * (kDL + kLD))
    )


# Transition probabilities
pdu = get_pDU(T)
pdL = get_pDL(T)
pdd = get_pDD(T)

puL = get_pUL(T)
pud = get_pUD(T)
puu = get_pUU(T)

pLu = get_pLU(T)
pLd = get_pLD(T)
pLL = get_pLL(T)


# State probabilities

pL0 = 0
pd0 = 0
pu0 = 1

pL = np.zeros(naps)
pd = np.zeros(naps)
pu = np.zeros(naps)

pL[0] = pL0
pd[0] = pd0
pu[0] = pu0

for i in range(naps - 1):

    pd[i+1] = (
        pd[i] * (1 - pr[i+1]) * (1 - pdu - pdL)
        + pd[i] * pr[i+1] * pud
        + pu[i] * pud
        + pL[i] * pLd
    )

    pL[i+1] = (
        pL[i] * (1 - pLu - pLd)
        + pd[i] * (1 - pr[i+1]) * pdL
        + pd[i] * pr[i+1] * puL
        + pu[i] * puL
    )

    pu[i+1] = 1 - pL[i+1] - pd[i+1]


# Mean QC
qc = np.zeros(naps)
qc[1:] = M * pr[1:] * pd[:-1]


# Valid AP indices for E[b_i b_(i+1)]
i = np.arange(1, naps - 1)


# E[b_i b_(i+1)]
E_bibi1 = M**2 * pd[i-1] * pr[i] * pr[i+1] * (
    pd[i-1] * (1 - pr[i]) * (1 - pdu - pdL)
    + pd[i-1] * pr[i]
    + pud
)


# E[b_i] and E[b_(i+1)]
mean_i = qc[i]
mean_i1 = qc[i+1]


# Var(b_i) and Var(b_(i+1))
var_i = M * pr[i] * pd[i-1] * (1 - pr[i] * pd[i-1])
var_i1 = M * pr[i+1] * pd[i] * (1 - pr[i+1] * pd[i])


# Lag-1 covariance
cov_lag1 = E_bibi1 - mean_i * mean_i1


# Normalized lag-1 autocorrelation
autocorr_lag1 = cov_lag1 / np.sqrt(var_i * var_i1)


# Plot
plt.figure(figsize=(6,5))
plt.plot(i, autocorr_lag1)
