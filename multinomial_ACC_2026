    return E1 * kUL * ((-1 + E2) * (-kDL * (kDL + kLD - kLU) + (kDL + 2 * kLD) * kUL) - kDL * D - E2 * kDL * D + 2 * E3 * kDL * D) / C

def get_pUD(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(D * T)
    E3 = np.exp(0.5 * (S + D) * T)
    C = 2 * (kLD * kUL + kDL * (kLU + kUL)) * D
    return E1 * kLD * kUL * (-((-1 + E2) * S) - D - E2 * D + 2 * E3 * D) / C

T = 1 / f
i_values = np.arange(naps)

puu = get_pUU(T)
puL = get_pUL(T)
pud = get_pUD(T)

pLu = get_pLU(T)
pLL = get_pLL(T)
pLd = get_pLD(T)

pdu = get_pDU(T)
pdL = get_pDL(T)
pdd = get_pDD(T)

fig,ax = plt.subplots(1,2,figsize=(8,5))

for prinf in prinf_values:

    # Hill function for release probability
    pr = pr0 + (prinf - pr0) / (1 + (i_values / thr)**H)

    pL = np.zeros(naps)
    pd = np.zeros(naps)
    pu = np.zeros(naps)

    pL[0] = 0
    pd[0] = 0
    pu[0] = 1

    for i in range(naps - 1):

        pd[i+1] = (
            pd[i] * (1 - pr[i+1]) * (1 - pdu - pdL)
            + pd[i] * pr[i+1] * pud
            + pu[i] * pud
            + pL[i] * pLd
        )

        pL[i+1] = (
            pL[i] * (1 - pLu - pLd)
            + pd[i] * (1 - pr[i+1]) * pdL
            + pd[i] * pr[i+1] * puL
            + pu[i] * puL
        )

        pu[i+1] = 1 - pL[i+1] - pd[i+1]

    # Mean QC
    qc = np.zeros(naps)
    qc[1:] = M * pr[1:] * pd[:-1]

    # FF
    qcff_theory = np.zeros(naps)
    qcff_theory[1:] = 1 - pr[1:] * pd[:-1]

    ax[0].plot(
        i_values[1:],
        qc[1:],
        label=f'prinf = {prinf:.3f}',
        linewidth=3
    )

    ax[1].plot(
        i_values[1:],
        qcff_theory[1:],
        label=f'prinf = {prinf:.3f}',
        linewidth=3
    )

ax[0].set_xlabel('AP stimulus number, i')
ax[0].set_ylabel('Mean QC')
ax[0].legend()

ax[1].set_xlabel('AP stimulus number, i')
ax[1].set_ylabel('FF')
ax[1].legend()

plt.tight_layout()
plt.show()

#%% multiple pools

import numpy as np
import matplotlib.pyplot as plt

# Model parameters
pool_counts = [1,2,3,4]

M = np.array([100,100,100,100])

f = 100
T = 1 / f
naps = 100

# Each row: [xmin, xmax, thr, H]
pr_params = np.array([
    [0.1, 1, 20, 2],
    [0.1, 1, 20, 2],
    [0.1, 1, 20, 2],
    [0.1, 1, 20, 2]
])

# Each row: [kUL, kLU, kLD, kDL]
rate_params = np.array([
    [10, 1, 50, 1],
    [10, 1, 50, 1],
    [10, 1, 50, 1],
    [10, 1, 50, 1]
])

def get_transition_probs(T,kDL,kLD,kLU,kUL):

    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(D * T)
    E3 = np.exp(0.5 * (S + D) * T)
    C = 2 * (kLD * kUL + kDL * (kLU + kUL)) * D

    pDU = E1 * kDL * kLU * (-((-1 + E2) * S) - D - E2 * D + 2 * E3 * D) / C
    pDL = E1 * kDL * ((-1 + E2) * ((kLD - kLU - kUL) * kUL + kDL * (2 * kLU + kUL)) - kUL * D - E2 * kUL * D + 2 * E3 * kUL * D) / C
    pDD = E1 * (-((-1 + E2) * kDL * (kLD * (-kLU + kUL) + kDL * (kLU + kUL) - (kLU + kUL)**2)) + kDL * kLU * D + E2 * kDL * kLU * D + kDL * kUL * D + E2 * kDL * kUL * D + 2 * E3 * kLD * kUL * D) / C

    pLU = E1 * kLU * ((-1 + E2) * (-kDL * (kDL + kLD - kLU) + (kDL + 2 * kLD) * kUL) - kDL * D - E2 * kDL * D + 2 * E3 * kDL * D) / C
    pLL = E1 * ((-1 + E2) * (kDL**2 * kLU - kLD * (kLD + kLU - kUL) * kUL - kDL * (kLD + kLU) * (kLU + kUL)) + kDL * kLU * D + E2 * kDL * kLU * D + 2 * E3 * kDL * kUL * D + kLD * kUL * D + E2 * kLD * kUL * D) / C
    pLD = E1 * kLD * ((-1 + E2) * ((kLD - kLU - kUL) * kUL + kDL * (2 * kLU + kUL)) - kUL * D - E2 * kUL * D + 2 * E3 * kUL * D) / C

    pUU = E1 * (-((-1 + E2) * kUL * (-kDL**2 - kLD * (kLD + kLU - kUL) + kDL * (-2 * kLD + kLU + kUL))) + 2 * E3 * kDL * kLU * D + kDL * kUL * D + E2 * kDL * kUL * D + kLD * kUL * D + E2 * kLD * kUL * D) / C
    pUL = E1 * kUL * ((-1 + E2) * (-kDL * (kDL + kLD - kLU) + (kDL + 2 * kLD) * kUL) - kDL * D - E2 * kDL * D + 2 * E3 * kDL * D) / C
    pUD = E1 * kLD * kUL * (-((-1 + E2) * S) - D - E2 * D + 2 * E3 * D) / C

    return pUU,pUL,pUD,pLU,pLL,pLD,pDU,pDL,pDD


i_values = np.arange(naps)

mean_qc_all = {}
variance_qc_all = {}
ff_all = {}

for npools in pool_counts:

    mean_qc = np.zeros(naps)
    variance_qc = np.zeros(naps)

    for j in range(npools):

        xmin,xmax,thr,H = pr_params[j]
        kUL,kLU,kLD,kDL = rate_params[j]

        pr = xmin + (xmax - xmin) / (1 + (i_values / thr)**H)

        pUU,pUL,pUD,pLU,pLL,pLD,pDU,pDL,pDD = get_transition_probs(
            T,kDL,kLD,kLU,kUL
        )

        pu = np.zeros(naps)
        pL = np.zeros(naps)
        pd = np.zeros(naps)

        pu[0] = 1

        for i in range(naps - 1):

            pd[i+1] = (
                pd[i] * (1 - pr[i+1]) * (1 - pDU - pDL)
                + pd[i] * pr[i+1] * pUD
                + pu[i] * pUD
                + pL[i] * pLD
            )

            pL[i+1] = (
                pL[i] * (1 - pLU - pLD)
                + pd[i] * (1 - pr[i+1]) * pDL
                + pd[i] * pr[i+1] * pUL
                + pu[i] * pUL
            )

            pu[i+1] = 1 - pL[i+1] - pd[i+1]

        q = pr[1:] * pd[:-1]

        pool_mean = M[j] * q
        pool_variance = M[j] * q * (1 - q)

        mean_qc[1:] += pool_mean
        variance_qc[1:] += pool_variance

    ff = np.zeros(naps)
    ff[1:] = variance_qc[1:] / mean_qc[1:]

    mean_qc_all[npools] = mean_qc
    variance_qc_all[npools] = variance_qc
    ff_all[npools] = ff


# Plot
fig,ax = plt.subplots(1,2)

for npools in pool_counts:
    ax[0].plot(
        i_values[1:],
        mean_qc_all[npools][1:],
        label=f'{npools} pool'
    )

ax[0].set_xlabel('AP stimulus number, i')
ax[0].set_ylabel('Mean QC')
ax[0].legend()

for npools in pool_counts:
    ax[1].plot(
        i_values[1:],
        ff_all[npools][1:],
        label=f'{npools} pool'
    )

ax[1].set_xlabel('AP stimulus number, i')
ax[1].set_ylabel('FF')
ax[1].legend()

plt.tight_layout()
plt.show()
