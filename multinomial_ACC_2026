import numpy as np
from matplotlib.pyplot import plot as pt
import matplotlib.pyplot as plt
from numpy.random import exponential, binomial, gamma
from numpy import exp
from numpy import sqrt as Sqrt
from numpy import log as Log

def simulate(nu, nL, nd, f, pr0, prinf, M, kuL, kLu, kLd, kdL, naps, delta_t, navgs):
    
    bmean=[]
    
    for _ in range(navgs):
    
        nulist=[]
        nLlist=[]
        ndlist=[]
        tlist=[]
        prelist=[]
        blist=[]

        tcurr=0
        ratio = 0
        timer = delta_t
        bnum=0
        e=1e-6
        aptimer=1/f
        while bnum<naps:
            if bnum==0:
                t0=0
            else:
                t0=aptimer
            t1=exponential(1/(kuL*(M-nL-nd)+e)) # uL
            t2=exponential(1/(kLu*nL+e))#Lu
            t3=exponential(1/(kLd*nL+e))#Ld
            t4=exponential(1/(kdL*nd+e))
            t5 = timer
            
            times=[t0,t1,t2,t3,t4,t5]
            minarg=np.argmin(times)
            tmin=np.min(times)
            
            if minarg==0: # AP occurrs
                b = binomial(nd, pr0)
                if bnum==0:
                    tlist.append(tcurr)
                    nulist.append(nu)
                    nLlist.append(nL)
                    ndlist.append(nd)
                blist.append(b)
                nd-=b
                nu+=b
                nulist.append(nu)
                nLlist.append(nL)
                ndlist.append(nd)
                tlist.append(tcurr+tmin)
                tmin = t0
                timer-=tmin
                aptimer=1/f
                prelist.append(tcurr+tmin)
                bnum+=1
    
            elif minarg==1: #uL
                nu-=1
                nL+=1
                tmin = t1
                timer-=tmin
                aptimer-=tmin

            elif minarg==2: #Lu
                nL-=1
                nu+=1
                tmin = t2
                timer-=tmin
                aptimer-=tmin
                
            elif minarg==3: #Ld
                nL-=1
                nd+=1
                tmin = t3
                timer-=tmin
                aptimer-=tmin
                
            elif minarg==4: #uL
                nd-=1
                nL+=1
                tmin = t4
                timer-=tmin
                aptimer-=tmin
    
            else:
                tmin=t5
                timer = delta_t
                aptimer-=tmin
                if tcurr >= ratio*naps/f:
                    nulist.append(nu)
                    nLlist.append(nL)
                    ndlist.append(nd)
                    tlist.append(tcurr)
                    
            tcurr += tmin
        bmean.append(blist)
    bmean=np.array(bmean)
    bmean=np.mean(bmean,axis=0)
    return tlist, nulist, nLlist, ndlist, prelist, blist, bmean

kDL = 1
