#%% Check pd and b and ff - varyiable pr
import numpy as np
import matplotlib.pyplot as plt
from scipy.linalg import expm

def get_transition_matrix(T):
    Q = np.array([
        [-kUL,          kUL,          0],
        [ kLU, -(kLU + kLD),         kLD],
        [   0,           kDL,       -kDL]
    ])
    return expm(Q*T)


def get_next_state(s):
    r = np.random.rand()
    bounds = boundslist[int(s)]

    if r <= bounds[0]:
        return 0
    if r <= bounds[1]:
        return 1
    return 2


kDL = 10
kLD = 100
kLU = 10
kUL = 20

M = 100
f = 10

pr0 = 0.1
prinf = 0.1
thr = 10
H = 2

T = 1 / f
naps = 100
navgs = 100

# Transition matrix
P = get_transition_matrix(T)

# Rows = final state, columns = initial state
puu = P[0,0]
puL = P[0,1]
pud = P[0,2]

pLu = P[1,0]
pLL = P[1,1]
pLd = P[1,2]

pdu = P[2,0]
pdL = P[2,1]
pdd = P[2,2]

boundslist = [
    [puu, puu + puL, puu + puL + pud],
    [pLu, pLu + pLL, pLu + pLL + pLd],
    [pdu, pdu + pdL, pdu + pdL + pdd]
]

# Hill function for release probability
i_values = np.arange(naps)
pr = pr0 + (prinf - pr0) / (1 + (i_values / thr)**H)

ds = np.zeros((navgs, naps, M))
qc = np.zeros((navgs, naps))

for iav in range(navgs):
    for iap in range(naps):
        for ids in range(M):

            if iap == 0:
                state = 0

            else:
                state = ds[iav, iap-1, ids]

                if state == 2 and np.random.rand() < pr[iap]:
                    qc[iav, iap] += 1
                    state = 0

                state = get_next_state(state)

            ds[iav, iap, ids] = state


pavlist = []

for iav in range(navgs):

    pilist = []

    for iap in range(naps):

        p0 = np.sum(ds[iav, iap] == 0) / M
        p1 = np.sum(ds[iav, iap] == 1) / M
        p2 = np.sum(ds[iav, iap] == 2) / M

        pilist.append([p0, p1, p2])

    pavlist.append(np.array(pilist))

pavlist = np.array(pavlist)
pavg = np.mean(pavlist, axis=0)

pusim = pavg[:, 0]
pLsim = pavg[:, 1]
pdsim = pavg[:, 2]

qcavg = np.mean(qc, axis=0)

# FF of QC at each AP
qcvar = np.var(qc, axis=0, ddof=1)
qcff = qcvar / qcavg


# Theory
pL0 = 0
pd0 = 0
pu0 = 1

pL = np.zeros(naps)
pd = np.zeros(naps)
pu = np.zeros(naps)

pL[0] = pL0
pd[0] = pd0
pu[0] = pu0

for i in range(naps-1):

    # p_d(i+1)
    pd[i+1] = (
        pd[i] * (1-pr[i]) * pdd
        + pd[i] * pr[i] * pud
        + pu[i] * pud
        + pL[i] * pLd
    )

    # p_L(i+1)
    pL[i+1] = (
        pL[i] * (1-pLu-pLd)
        + pd[i] * (1-pr[i]) * pdL
        + pd[i] * pr[i] * puL
        + pu[i] * puL
    )

    # p_u(i+1)
    pu[i+1] = 1 - pL[i+1] - pd[i+1]


# Mean QC at each AP
qc = np.zeros(naps)
qc[1:] = M * pr[1:] * pd[:-1]

# FF QC theory
qcff_theory = 1 - pr[1:] * pd[:-1]


plt.plot(pLsim[1:], label='pL(i) simulation')
plt.plot(pL[1:], label='pL(i) theory')

plt.plot(pdsim[1:], label='pD(i) simulation')
plt.plot(pd[1:], label='pD(i) theory')

plt.xlabel('AP stimulus number, i')
plt.ylabel('Probability(i)')
plt.legend()
plt.show()


fig, ax = plt.subplots(1, 2, figsize=(8,5))

ax[0].plot(qcavg[1:], label='Mean QC simulation')
ax[0].plot(qc[1:], label='Mean QC theory')

ax[0].set_xlabel('AP stimulus number, i')
ax[0].set_ylabel('Mean QC')
ax[0].legend()

ax[1].plot(qcff[1:], label='FF simulation')
ax[1].plot(qcff_theory[1:], label='FF theory')

ax[1].set_xlabel('AP stimulus number, i')
ax[1].set_ylabel('FF')
ax[1].legend()

plt.tight_layout()
plt.show()

