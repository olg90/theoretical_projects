def get_transition_probs(T,kUL,kLU,kLD,kDL):

    A = np.array([
        [-kUL,               kLU,               0],
        [ kUL, -(kLU + kLD),             kDL],
        [   0,               kLD,           -kDL]
    ])

    P = expm(A.T*T)

    pUU = P[0,0]
    pUL = P[0,1]
    pUD = P[0,2]

    pLU = P[1,0]
    pLL = P[1,1]
    pLD = P[1,2]

    pDU = P[2,0]
    pDL = P[2,1]
    pDD = P[2,2]

