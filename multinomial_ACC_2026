    return E1 * kUL * ((-1 + E2) * (-kDL * (kDL + kLD - kLU) + (kDL + 2 * kLD) * kUL) - kDL * D - E2 * kDL * D + 2 * E3 * kDL * D) / C


def get_pUD(T):
    S = kDL + kLD + kLU + kUL
