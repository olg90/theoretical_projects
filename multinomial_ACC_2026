    pr = prinf + (pr0-prinf)/(1+(i_values/thr)**H)

    pUU,pUL,pUD,pLU,pLL,pLD,pDU,pDL,pDD = get_transition_probs(
        T,kUL,kLU,kLD,kDL
    )

    pu = np.zeros(naps)
    pL = np.zeros(naps)
    pd = np.zeros(naps)

    pu[0] = 1

    for i in range(naps-1):

        pd[i+1] = (
            pd[i]*(1-pr[i+1])*(1-pDU-pDL)
            +pd[i]*pr[i+1]*pUD
            +pu[i]*pUD
            +pL[i]*pLD
        )

        pL[i+1] = (
            pL[i]*(1-pLU-pLD)
            +pd[i]*(1-pr[i+1])*pDL
            +pd[i]*pr[i+1]*pUL
            +pu[i]*pUL
        )

        pu[i+1] = 1-pL[i+1]-pd[i+1]

    q = pr[1:]*pd[:-1]

    mean_qc = np.zeros(naps)
    mean_qc[1:] = M*q

    return mean_qc


# ------------------------------------------------------------
# FIRST POOL IS FIXED
# Uses ONLY the first array in each parameter array
# ------------------------------------------------------------

mean_qc_1 = get_mean_qc(
    pr_params[0],
    rate_params[0]
)

mean_qc_all = {
    1: mean_qc_1
}

optimized_params = np.zeros((4,8))

optimized_params[0,:4] = pr_params[0]
optimized_params[0,4:] = rate_params[0]


# ------------------------------------------------------------
# Optimize pools 2, 3, and 4 independently
# to match the fixed first-pool mean QC
# ------------------------------------------------------------

bounds = [
    (0.001,1.0),     # pr0
    (0.001,1.0),     # prinf
    (1.0,100.0),     # thr
    (0.5,5.0),       # H
    (0.1,100.0),     # kUL
    (0.1,100.0),     # kLU
    (0.1,100.0),     # kLD
    (0.1,100.0)      # kDL
]


for pool in [2,3,4]:

    def objective(x):

        mean_qc = get_mean_qc(
            x[:4],
            x[4:]
        )

        valid = mean_qc_1 > 1e-8

        relative_error = (
            (mean_qc[valid]-mean_qc_1[valid])
            /mean_qc_1[valid]
        )

        return np.mean(relative_error**2)


    result = differential_evolution(
        objective,
        bounds,
        maxiter=1000,
        popsize=20,
        tol=1e-9,
        polish=True,
        seed=pool
    )

    optimized_params[pool-1] = result.x

    mean_qc_all[pool] = get_mean_qc(
        result.x[:4],
        result.x[4:]
    )


# ------------------------------------------------------------
# Print parameters
# ------------------------------------------------------------

for pool in pool_counts:

    print()
    print(f'Pool {pool}')

    print(f'pr0   = {optimized_params[pool-1,0]:.8f}')
    print(f'prinf = {optimized_params[pool-1,1]:.8f}')
    print(f'thr   = {optimized_params[pool-1,2]:.8f}')
    print(f'H     = {optimized_params[pool-1,3]:.8f}')

    print(f'kUL   = {optimized_params[pool-1,4]:.8f}')
    print(f'kLU   = {optimized_params[pool-1,5]:.8f}')
    print(f'kLD   = {optimized_params[pool-1,6]:.8f}')
    print(f'kDL   = {optimized_params[pool-1,7]:.8f}')

    error = np.mean(
        (
            (mean_qc_all[pool][1:]-mean_qc_1[1:])
            /mean_qc_1[1:]
        )**2
    )

    print(f'mean QC relative MSE = {error:.10e}')


# ------------------------------------------------------------
# Calculate Fano factor for each pool
# ------------------------------------------------------------

ff_all = {}

for pool in pool_counts:

    mean_qc = mean_qc_all[pool]

    q = np.zeros(naps)

    valid = mean_qc > 0
    q[valid] = mean_qc[valid]/M

    variance_qc = M*q*(1-q)

    ff = np.zeros(naps)
    ff[valid] = variance_qc[valid]/mean_qc[valid]

    ff_all[pool] = ff


# ------------------------------------------------------------
# Plot mean QC
# ------------------------------------------------------------

fig,ax = plt.subplots(figsize=(7,5))

for pool in pool_counts:

    ax.plot(
        i_values[1:],
        mean_qc_all[pool][1:],
        label=f'Pool {pool}'
    )

ax.set_xlabel('AP stimulus number, i')
ax.set_ylabel('Mean QC')
ax.legend()
ax.grid(True)

plt.tight_layout()
plt.show()


# ------------------------------------------------------------
# Plot Fano factor
# ------------------------------------------------------------

fig,ax = plt.subplots(figsize=(7,5))

for pool in pool_counts:

    ax.plot(
        i_values[1:],
        ff_all[pool][1:],
        label=f'Pool {pool}'
    )

ax.set_xlabel('AP stimulus number, i')
ax.set_ylabel('Fano factor')
ax.legend()
ax.grid(True)

plt.tight_layout()
plt.show()

