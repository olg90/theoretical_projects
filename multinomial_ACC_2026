import numpy as np
import matplotlib.pyplot as plt

def get_pDU(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(D * T)
    E3 = np.exp(0.5 * (S + D) * T)
    C = 2 * (kLD * kUL + kDL * (kLU + kUL)) * D
    return E1 * kDL * kLU * (-((-1 + E2) * S) - D - E2 * D + 2 * E3 * D) / C


def get_pDL(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(D * T)
    E3 = np.exp(0.5 * (S + D) * T)
    C = 2 * (kLD * kUL + kDL * (kLU + kUL)) * D
    return E1 * kDL * ((-1 + E2) * ((kLD - kLU - kUL) * kUL + kDL * (2 * kLU + kUL)) - kUL * D - E2 * kUL * D + 2 * E3 * kUL * D) / C


def get_pDD(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(D * T)
    E3 = np.exp(0.5 * (S + D) * T)
    C = 2 * (kLD * kUL + kDL * (kLU + kUL)) * D
    return E1 * (-((-1 + E2) * kDL * (kLD * (-kLU + kUL) + kDL * (kLU + kUL) - (kLU + kUL)**2)) + kDL * kLU * D + E2 * kDL * kLU * D + kDL * kUL * D + E2 * kDL * kUL * D + 2 * E3 * kLD * kUL * D) / C


def get_pLU(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(D * T)
    E3 = np.exp(0.5 * (S + D) * T)
    C = 2 * (kLD * kUL + kDL * (kLU + kUL)) * D
    return E1 * kLU * ((-1 + E2) * (-kDL * (kDL + kLD - kLU) + (kDL + 2 * kLD) * kUL) - kDL * D - E2 * kDL * D + 2 * E3 * kDL * D) / C


def get_pLL(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(D * T)
    E3 = np.exp(0.5 * (S + D) * T)
    C = 2 * (kLD * kUL + kDL * (kLU + kUL)) * D
    return E1 * ((-1 + E2) * (kDL**2 * kLU - kLD * (kLD + kLU - kUL) * kUL - kDL * (kLD + kLU) * (kLU + kUL)) + kDL * kLU * D + E2 * kDL * kLU * D + 2 * E3 * kDL * kUL * D + kLD * kUL * D + E2 * kLD * kUL * D) / C


def get_pLD(T):
    S = kDL + kLD + kLU + kUL
