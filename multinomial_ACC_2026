import numpy as np
import matplotlib.pyplot as plt
from scipy.linalg import expm

kDL = 10
kLD = 60
kLU = 10
kUL = 10 

M = 100
f = 10
T = 1 / f

pr0 = 0.1
prinf = 0.1
thr = 10
H = 2

i = 1
j_max = 9

def get_transition_matrix(T):
    Q = np.array([
        [-kUL,          kUL,          0],
        [ kLU, -(kLU + kLD),         kLD],
        [   0,           kDL,       -kDL]
    ])
    return expm(Q*T)

# Transition probabilities over one inter-AP interval
P = get_transition_matrix(T)
# this is the infinitesimal matrix which gives the transition rates for the markov chain between states


puu = P[0,0]
puL = P[0,1]
pud = P[0,2]

pLu = P[1,0]
pLL = P[1,1]
pLd = P[1,2]

pdu = P[2,0]
pdL = P[2,1]
pdd = P[2,2]

max_ap = i + j_max

pr = pr0 + (prinf-pr0)/(1+(np.arange(max_ap+1)/thr)**H)

pL = np.zeros(max_ap+1)
pd = np.zeros(max_ap+1)
pu = np.zeros(max_ap+1)

pu[0] = 1

for n in range(max_ap):

    pd[n+1] = (
        pd[n]*(1-pr[n])*(1-pdu-pdL)
        + pd[n]*pr[n]*pud
        + pu[n]*pud
        + pL[n]*pLd
    )

    pL[n+1] = (
        pL[n]*(1-pLu-pLd)
        + pd[n]*(1-pr[n])*pdL
        + pd[n]*pr[n]*puL
        + pu[n]*puL
    )

    pu[n+1] = 1-pL[n+1]-pd[n+1]

p_ri = pd[i]*pr[i]

j_values = np.arange(1,j_max+1)
rho = np.zeros(j_max)

for n,j in enumerate(j_values):

    pT = p_ri*pud
    pL_joint = p_ri*puL
    pU = p_ri*puu

    for k in range(i+1,i+j):

        pT_new = (
            pT*(1-pr[k])*pdd
            + pT*pr[k]*pud
            + pL_joint*pLd
            + pU*pud
        )

        pL_new = (
            pT*(1-pr[k])*pdL
            + pT*pr[k]*puL
            + pL_joint*pLL
            + pU*puL
        )

        pU_new = p_ri-pT_new-pL_new

        pT = pT_new
        pL_joint = pL_new
        pU = pU_new

    p_ri_rij = pT*pr[i+j]
    p_rij = pd[i+j]*pr[i+j]

    E_bibi_j = M*p_ri_rij + M*(M-1)*p_ri*p_rij

    E_bi = M*p_ri
    E_bij = M*p_rij

    var_bi = M*p_ri*(1-p_ri)
    var_bij = M*p_rij*(1-p_rij)

    cov_bibi_j = E_bibi_j-E_bi*E_bij

    rho[n] = cov_bibi_j/np.sqrt(var_bi*var_bij)

plt.figure(figsize=(7,5))
plt.plot(j_values,rho,'o-')
plt.xlabel(r'$j$')
plt.ylabel(r'$\rho(b_i,b_{i+j})$')
# plt.title(r'$\rho(b_i,b_{i+j})$')
plt.tight_layout()
plt.grid(True)
plt.show()

for j,value in zip(j_values,rho):
    print(f'j = {j:3d}, rho = {value:.8f}')
    

#%% prinf sweep

import numpy as np
import matplotlib.pyplot as plt

kDL = 10
kLD = 100
kLU = 10
kUL = 20

M = 100
f = 10

pr0 = 0.1
prinf_values = [pr0, 0.35,0.65,1]
# prinf_values = [pr0, 0.65,0.35,0.1]

thr = 20
H = 2

naps = 60

def get_pDU(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(D * T)
    E3 = np.exp(0.5 * (S + D) * T)
    C = 2 * (kLD * kUL + kDL * (kLU + kUL)) * D
    return E1 * kDL * kLU * (-((-1 + E2) * S) - D - E2 * D + 2 * E3 * D) / C

def get_pDL(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(D * T)
    E3 = np.exp(0.5 * (S + D) * T)
    C = 2 * (kLD * kUL + kDL * (kLU + kUL)) * D
    return E1 * kDL * ((-1 + E2) * ((kLD - kLU - kUL) * kUL + kDL * (2 * kLU + kUL)) - kUL * D - E2 * kUL * D + 2 * E3 * kUL * D) / C

def get_pDD(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
