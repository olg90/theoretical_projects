def get_pUU(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
    E2 = np.exp(D * T)
    E3 = np.exp(0.5 * (S + D) * T)
    C = 2 * (kLD * kUL + kDL * (kLU + kUL)) * D
    return E1 * (-((-1 + E2) * kUL * (-kDL**2 - kLD * (kLD + kLU - kUL) + kDL * (-2 * kLD + kLU + kUL))) + 2 * E3 * kDL * kLU * D + kDL * kUL * D + E2 * kDL * kUL * D + kLD * kUL * D + E2 * kLD * kUL * D) / C


def get_pUL(T):
    S = kDL + kLD + kLU + kUL
    D = np.sqrt(S**2 - 4 * (kLD * kUL + kDL * (kLU + kUL)))
    E1 = np.exp(-0.5 * (S + D) * T)
