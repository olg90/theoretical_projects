import numpy as np
import matplotlib.pyplot as plt
from scipy.linalg import expm

kDL = 10
kLD = 10
kLU = 10
kUL = 10

pr0 = 0.1
prinf = 1
thr = 20
H = 2

M = 100
f = 100
T = 1 / f

naps = 100

# steady state
denom = kDL*kLU + kDL*kUL + kLD*kUL
puss = (kDL*kLU) / denom
pLss = (kDL*kUL) / denom
pdss = (kLD*kUL) / denom
initial_states = [puss,pLss,pdss]

# Continuous-time generator
Q = np.array([
    [-kUL,          kUL,          0],
    [ kLU, -(kLU + kLD),         kLD],
    [   0,           kDL,       -kDL]
])

P = expm(Q*T)

puu = P[0,0]
puL = P[0,1]
pud = P[0,2]

pLu = P[1,0]
pLL = P[1,1]
pLd = P[1,2]

pdu = P[2,0]
pdL = P[2,1]
pdd = P[2,2]

# Hill function for release probability
i_values = np.arange(naps)

pr = prinf + (pr0 - prinf) / (
    1 + (i_values / thr)**H
)

# State probabilities
pu = np.zeros(naps)
pL = np.zeros(naps)
pd = np.zeros(naps)

pu[0],pL[0],pd[0] = initial_states

for i in range(naps - 1):

    pd[i+1] = (
        pd[i] * (1 - pr[i]) * pdd
        + pd[i] * pr[i] * pud
        + pu[i] * pud
        + pL[i] * pLd
    )

    pL[i+1] = (
        pL[i] * (1 - pLu - pLd)
        + pd[i] * (1 - pr[i]) * pdL
        + pd[i] * pr[i] * puL
        + pu[i] * puL
    )

    pu[i+1] = 1 - pL[i+1] - pd[i+1]

# Multinomial covariance
cov_dL = -M * pd * pL

# Variances
var_d = M * pd * (1 - pd)
var_L = M * pL * (1 - pL)

# Pearson correlation coefficient
rho_dL = cov_dL / np.sqrt(var_d * var_L)

# Equivalent closed-form expression
rho_dL_check = -np.sqrt(
    (pd * pL) /
    ((1 - pd) * (1 - pL))
)

# Plot
fig,ax = plt.subplots(figsize=(8,5))

fs = 15
lw = 3

ax.plot(
    range(1,naps+1),
    rho_dL,
    marker='o',
    markersize=5,
    linewidth=lw,
    label=r'$\rho(n_D,n_L)$'
)

ax.axhline(0,linewidth=1)

ax.set_xlabel('AP stimulus number, $i$',fontsize=fs)
ax.set_ylabel(r'$\rho(n_D,n_L)$',fontsize=fs)
ax.tick_params(axis='both',labelsize=fs)
ax.legend(fontsize=12)

plt.tight_layout()
plt.show()
