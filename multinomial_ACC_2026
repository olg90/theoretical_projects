    print(f'thr   = {optimized_params[pool-1,2]:.8f}')
    print(f'H     = {optimized_params[pool-1,3]:.8f}')

    print(f'kUL   = {optimized_params[pool-1,4]:.8f}')
    print(f'kLU   = {optimized_params[pool-1,5]:.8f}')
    print(f'kLD   = {optimized_params[pool-1,6]:.8f}')
    print(f'kDL   = {optimized_params[pool-1,7]:.8f}')

    error = np.mean(
        (
            (mean_qc_all[pool][1:]-mean_qc_1[1:])
            /mean_qc_1[1:]
        )**2
    )

    print(f'mean QC relative MSE = {error:.10e}')


# ------------------------------------------------------------
# Calculate Fano factor for each pool
# ------------------------------------------------------------

ff_all = {}

for pool in pool_counts:

    mean_qc = mean_qc_all[pool]

    q = np.zeros(naps)

    valid = mean_qc > 0
    q[valid] = mean_qc[valid]/M

    variance_qc = M*q*(1-q)

    ff = np.zeros(naps)
    ff[valid] = variance_qc[valid]/mean_qc[valid]

    ff_all[pool] = ff


# ------------------------------------------------------------
# Plot mean QC
# ------------------------------------------------------------

fig,ax = plt.subplots(figsize=(7,5))

for pool in pool_counts:

    ax.plot(
        i_values[1:],
        mean_qc_all[pool][1:],
        label=f'Pool {pool}'
    )

ax.set_xlabel('AP stimulus number, i')
ax.set_ylabel('Mean QC')
ax.legend()
ax.grid(True)

plt.tight_layout()
plt.show()


# ------------------------------------------------------------
# Plot Fano factor
# ------------------------------------------------------------

fig,ax = plt.subplots(figsize=(7,5))

for pool in pool_counts:

    ax.plot(
        i_values[1:],
        ff_all[pool][1:],
        label=f'Pool {pool}'
    )

ax.set_xlabel('AP stimulus number, i')
ax.set_ylabel('Fano factor')
ax.legend()
ax.grid(True)

plt.tight_layout()
plt.show()
