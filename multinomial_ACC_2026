    pdd = P[2,2]

    rho_values = np.zeros(len(pr_values))

    for m,pr0 in enumerate(pr_values):

        prinf = pr0

        pr = pr0 + (prinf-pr0)/(1+(np.arange(3)/thr)**H)

        pL = np.zeros(3)
        pd = np.zeros(3)
        pu = np.zeros(3)

        pu[0],pL[0],pd[0] = initial_states

        for n in range(2):

            pd[n+1] = (
                pd[n]*(1-pr[n])*(1-pdu-pdL)
                + pd[n]*pr[n]*pud
                + pu[n]*pud
                + pL[n]*pLd
            )

            pL[n+1] = (
                pL[n]*(1-pLu-pLd)
                + pd[n]*(1-pr[n])*pdL
                + pd[n]*pr[n]*puL
                + pu[n]*puL
            )

            pu[n+1] = 1-pL[n+1]-pd[n+1]

        # rho(1,2), so j = 1
        p_ri = pd[i]*pr[i]

        pT = p_ri*pud
        pL_joint = p_ri*puL
        pU = p_ri*puu

        p_ri_rij = pT*pr[i+1]
        p_rij = pd[i+1]*pr[i+1]

        E_bibi_j = M*p_ri_rij + M*(M-1)*p_ri*p_rij

        E_bi = M*p_ri
        E_bij = M*p_rij

        var_bi = M*p_ri*(1-p_ri)
        var_bij = M*p_rij*(1-p_rij)

        cov_bibi_j = E_bibi_j-E_bi*E_bij

        rho_values[m] = cov_bibi_j/np.sqrt(var_bi*var_bij)

    # Minimum rho
    min_index = np.argmin(rho_values)

    return pr_values[min_index],rho_values[min_index]


